{
  "name": "workout-logger-frontend",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/input.css -o ./app/static/styles.css --minify",
    "build": "npm run build:css",
    "lint": "eslint app/static frontend e2e playwright.config.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run frontend --coverage.enabled=false",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
