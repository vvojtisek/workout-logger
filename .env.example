API_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=sqlite+aiosqlite:////data/workout_logger.db
APP_ENV=production
APP_VERSION=1.0.0
LOG_LEVEL=INFO
TRUSTED_HOSTS=localhost,127.0.0.1,workout.example.com
PUBLIC_BASE_URL=https://workout.example.com

# --- MCP OAuth 2.1 (ChatGPT / MCP clients only; REST keeps X-API-Key) ---
# Disabled by default for local development, where the /mcp endpoint then has
# no auth at all -- never leave this disabled in a reachable deployment.
MCP_OAUTH_ENABLED=false
# "auth0" (default): FastMCP's OAuth-proxy bridge to an Auth0 application.
# "jwt": a plain resource-server JWT verifier against a known issuer's JWKS.
MCP_OAUTH_PROVIDER=auth0
# Auth0 tenant "OIDC configuration" URL, e.g. https://your-tenant.us.auth0.com
MCP_OAUTH_ISSUER=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
# The Auth0 API identifier created for this MCP server.
MCP_OAUTH_AUDIENCE=
# Defaults to PUBLIC_BASE_URL when unset; only set this if the MCP OAuth
# endpoints should live at a different public origin than the REST API.
MCP_OAUTH_BASE_URL=
# Comma-separated, stable IdP subject ("sub" claim) values allowed to use the
# MCP server -- this is a private, single-user/family application, so a valid
# Auth0 login alone is not sufficient. Example: auth0|65f1...
MCP_OAUTH_ALLOWED_SUBJECTS=
# Secret used to sign the FastMCP-issued downstream access/refresh tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_OAUTH_JWT_SIGNING_KEY=
# Directory (on the same persistent volume as DATABASE_URL) where encrypted
# OAuth client-registration and token state is stored across restarts.
MCP_OAUTH_STORAGE_DIR=/data/mcp-oauth
# Source material for the Fernet key that encrypts the OAuth storage above.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_OAUTH_STORAGE_KEY=
# Only used when MCP_OAUTH_PROVIDER=jwt.
MCP_OAUTH_JWKS_URI=
MCP_OAUTH_JWT_PUBLIC_KEY=
