# Install as /srv/workout-logger/.env.production with mode 0600.
# Generate with: openssl rand -hex 32
API_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
LOG_LEVEL=INFO

# Optional MCP OAuth. While disabled, its transport and discovery routes are
# not mounted. Enable only after all Auth0 values and secrets below are set.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_PROVIDER=auth0
MCP_OAUTH_ISSUER=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_AUDIENCE=https://fitness.vvojtisek.eu/mcp/
MCP_OAUTH_ALLOWED_SUBJECTS=
MCP_OAUTH_JWT_SIGNING_KEY=
MCP_OAUTH_STORAGE_KEY=
